{
  "name": "sftp-dev-sync",
  "displayName": "SFTP Dev Sync",
  "description": "Extensão SFTP para VS Code. Sincroniza pastas e arquivos com o servidor de forma simples e rápida. Suporta upload, download, sync automático e seleção de pastas permitidas.",
  "version": "0.0.1",
  "publisher": "luannsr12",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "sftp",
    "sync",
    "upload",
    "download",
    "remote",
    "ftp",
    "ssh"
  ],
  "homepage": "https://github.com/luannsr12/sftp-dev-sync",
  "repository": {
    "type": "git",
    "url": "https://github.com/luannsr12/sftp-dev-sync.git"
  },
  "icon": "media/icon.png",
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:sftp-dev-sync.config",
    "workspaceContains:.vscode/sftp-dev-sync.json"
  ],
  "contributes": {
    "commands": [
      {
        "command": "sftp-dev-sync.config",
        "title": "SFTP Dev Sync: Create/Edit Config",
        "category": "SFTP Dev Sync"
      },
      {
        "command": "sftp-dev-sync.download.project",
        "title": "Download Project",
        "category": "SFTP Dev Sync"
      },
      {
        "command": "sftp-dev-sync.upload.file",
        "title": "Upload File",
        "category": "SFTP Dev Sync"
      },
      {
        "command": "sftp-dev-sync.sync.localToRemote",
        "title": "Sync Local → Remote",
        "category": "SFTP Dev Sync"
      },
      {
        "command": "sftp-dev-sync.sync.remoteToLocal",
        "title": "Sync Remote → Local",
        "category": "SFTP Dev Sync"
      },
      {
        "command": "sftp-dev-sync.diff",
        "title": "Diff Local vs Remote",
        "category": "SFTP Dev Sync"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "sftp-dev-sync-explorer",
          "name": "SFTP Dev Sync",
          "when": "workspaceContains:.vscode/sftp-dev-sync.json"
        }
      ]
    },
    "configuration": {
      "title": "SFTP Dev Sync",
      "properties": {
        "sftp-dev-sync.showOutput": {
          "type": "boolean",
          "default": true,
          "description": "Show output panel when operations complete"
        }
      }
    },
    "jsonValidation": [
      {
        "fileMatch": ".vscode/sftp-dev-sync.json",
        "url": "./schemas/sftp-dev-sync.schema.json"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "webpack --mode production",
    "watch": "webpack --mode development --watch",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src --ext ts",
    "test": "node ./out/test/runTest.js"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/mocha": "^10.0.1",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^6.0.0",
    "@typescript-eslint/parser": "^6.0.0",
    "@vscode/test-electron": "^2.3.2",
    "eslint": "^8.40.0",
    "glob": "^10.3.3",
    "mocha": "^10.2.0",
    "ts-loader": "^9.4.3",
    "typescript": "^5.1.3",
    "webpack": "^5.88.0",
    "webpack-cli": "^5.1.4"
  },
  "dependencies": {
    "fs-extra": "^11.1.1",
    "minimatch": "^9.0.3",
    "p-queue": "^7.3.4",
    "ssh2-sftp-client": "^9.1.0",
    "upath": "^2.0.1"
  }
}
